// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Set provider to sqlite
  url      = env("DATABASE_URL") // Points to the .env file
}

// Organization model for multi-tenancy
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique // URL-friendly identifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users     UserOrganization[]
  templates Template[]
  campaigns Campaign[]
}

// Join table for User-Organization many-to-many relationship
model UserOrganization {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String   @default("member") // "owner", "admin", "member"
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId]) // A user can only belong to an organization once
  @@index([userId])
  @@index([organizationId])
}

// Define the Template model
model Template {
  id             String   @id @default(cuid()) // Use cuid for unique IDs
  name           String
  htmlContent    String   // Store the rich text HTML content
  isArchived     Boolean  @default(false) // Added for archiving
  organizationId String   // Multi-tenancy: which organization owns this template
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isArchived]) // Compound index for common queries
}

// Model for tracking email sending campaigns
model Campaign {
  id              String              @id @default(cuid())
  name            String?             // Optional name for the campaign
  status          String              @default("pending") // e.g., pending, processing, completed, failed
  totalRecipients Int
  sentCount       Int                 @default(0)
  failedCount     Int                 @default(0)
  skippedCount    Int                 @default(0)
  organizationId  String              // Multi-tenancy: which organization owns this campaign
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // Store config used for the campaign
  subject         String
  fromEmail       String
  fromName        String?
  replyToEmail    String
  templateId      String?             // Link to the Template used (optional if storing HTML directly)
  // template     Template? @relation(fields: [templateId], references: [id]) // Optional relation
  pdfTemplatePath String?             // Store path if PDF was used (for potential retry info)
  scheduledAt     DateTime?           // Optional time for scheduled dispatch
  isArchived      Boolean             @default(false) // Added for archiving

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipients   CampaignRecipient[] // Relation to individual recipients

  @@index([organizationId])
  @@index([organizationId, isArchived]) // Compound index for common queries
  @@index([organizationId, status]) // Index for status filtering per org
}

// Model for tracking the status of each recipient within a campaign
model CampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade) // Cascade delete recipients if campaign is deleted

  recipientEmail String
  status      String   @default("pending") // e.g., pending, sent, failed, skipped
  errorMessage String?  // Store error message on failure
  processedAt DateTime? // Timestamp when processed

  // Store the specific data used for this recipient (optional, for retry/debugging)
  // recipientDataJson String?

  @@index([campaignId]) // Index for faster querying by campaign
  @@index([status])     // Index for finding pending/failed recipients
}

// Define the User model for authentication
model User {
  id        String   @id @default(cuid())
  email     String   @unique // User's email address, must be unique
  password  String   // Hashed password (random string for OAuth users)

  // OAuth fields
  googleId  String?  @unique // Google's unique user ID
  name      String?  // User's full name (from Google or manual entry)
  picture   String?  // Profile picture URL (from Google)
  authProvider String @default("password") // "password" or "google"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations - Multi-tenancy
  organizations UserOrganization[] // Users can belong to multiple organizations
}
