# Environment Variables

# Database
DATABASE_URL="file:./dev.db"

# Authentication (CHANGE THIS!)
JWT_SECRET="your-super-secret-jwt-key-change-this-to-random-string-min-32-chars"

# Email Service
# Email provider: sendgrid, ses, or fake (for testing)
EMAIL_PROVIDER="sendgrid"

# SendGrid (if using EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY="your-sendgrid-api-key-here"

# AWS SES (if using EMAIL_PROVIDER=ses)
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="your-aws-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"

# Redis (Optional - for background jobs with BullMQ)
# If not set, defaults to redis://localhost:6379
# For local development, install Redis and run: redis-server
REDIS_URL="redis://localhost:6379"

# Upstash Redis (Optional - for API rate limiting)
# Get these from: https://console.upstash.com/
# If not set, rate limiting will be disabled
# UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# Google OAuth (Optional - for Google sign-in)
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id-here"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Application
NODE_ENV="development"
PORT="3000"

# Optional
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Note: Never commit the actual .env file to version control!
# This is just an example. Copy to .env and fill in real values.
